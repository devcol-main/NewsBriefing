{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push origin main)",
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(**/.env)"
    ]
  }
}
